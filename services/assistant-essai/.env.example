# Ne jamais committer de vrai .env ni coller ces valeurs dans le widget.

PORT=8080

# URL de base du proxy modèles (LiteLLM), sans slash final
LITELLM_BASE_URL=https://example.litellm.invalid

# Clé API LiteLLM (secret serveur uniquement)
LITELLM_API_KEY=

# Nom du modèle exposé par LiteLLM
LITELLM_MODEL=mistral-small

# Jeton partagé widget ↔ service (Bearer). Laisser vide = auth désactivée (local seulement)
ASSISTANT_SHARED_SECRET=

# Origines CORS autorisées (virgules). Défaut : localhost widget + Pages
# CORS_ORIGINS=http://localhost:5175,https://dnum-socialgouv.github.io

# Essai seulement : détail d’erreur LiteLLM dans la réponse JSON
# ASSISTANT_DEBUG=1
